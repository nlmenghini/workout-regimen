# Normalize line endings for text files so Git stores them consistently
# (LF in the repo) regardless of what OS/editor touches them, and stops
# Git/GitHub Desktop from warning about LF -> CRLF conversion on checkout.
* text=auto eol=lf

*.html text eol=lf
*.js   text eol=lf
*.json text eol=lf
*.md   text eol=lf
*.css  text eol=lf

# Binary files should never be touched
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
